# Copy to .env and fill in the key. Get a free key at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Model ids are passed straight to LiteLLM. Change if the default is retired.
LLM_MODEL=gemini/gemini-2.5-flash-lite
LLM_FALLBACK_MODEL=gemini/gemini-2.5-flash
# litellm | mock   (mock runs the whole app offline with a rule-based stand-in)
LLM_PROVIDER=litellm
# off | record | replay
LLM_CASSETTE_MODE=off
LLM_CASSETTE_PATH=data/cassettes/demo.jsonl
# off | llm   (llm adds one verification call per turn)
VERIFY_MODE=off

# structured | fts | hybrid | embeddings
RETRIEVAL_MODE=hybrid

# Expose /debug/* and /admin/* and enable the admin page
DEBUG_ENDPOINTS=false

# Freeze the clock for reproducible bookings and screenshots, ISO 8601 with offset
# DEMO_NOW=2026-09-05T14:30:00+04:00

BACKEND_URL=http://127.0.0.1:8000
BACKEND_PORT=8000

# Keeps litellm from downloading its price table at import
LITELLM_LOCAL_MODEL_COST_MAP=True

# Ablation flags, all off. Turn one on to demo the failure it prevents.
ABLATE_SANITIZER=false
ABLATE_PREFILTER=false
ABLATE_POSTFILTER=false
ABLATE_GROUNDING_CHECK=false
ABLATE_RELAXATION=false
ABLATE_RESOLVER=false
